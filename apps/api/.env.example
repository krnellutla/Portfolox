# Copy to .env for local development. Never commit real secrets.
#
# Local Postgres setup (no Docker required, but a docker run equivalent is shown below
# for environments without a local Postgres install):
#
#   docker run --name portfoliohub-pg -e POSTGRES_PASSWORD=postgres \
#     -p 5432:5432 -d postgres:15
#
# Then, as a superuser, provision the two roles this app expects:
#
#   CREATE ROLE portfoliohub_migrator LOGIN PASSWORD '<migrator-password>' CREATEROLE;
#   CREATE DATABASE portfoliohub_dev  OWNER portfoliohub_migrator;
#   CREATE DATABASE portfoliohub_test OWNER portfoliohub_migrator;
#
#   CREATE ROLE portfoliohub_app LOGIN PASSWORD '<app-password>'
#     NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
#   GRANT CONNECT ON DATABASE portfoliohub_dev, portfoliohub_test TO portfoliohub_app;
#
# DATABASE_MIGRATION_URL: used by drizzle-kit and the migrator. Must own the schema
# objects so it can run DDL, ENABLE/FORCE ROW LEVEL SECURITY, and GRANT to the runtime role.
DATABASE_MIGRATION_URL=postgres://portfoliohub_migrator:CHANGE_ME@127.0.0.1:5432/portfoliohub_dev

# DATABASE_URL: used by the application connection pool at runtime. MUST be a
# non-superuser, NOBYPASSRLS role or Row-Level Security is silently bypassed.
DATABASE_URL=postgres://portfoliohub_app:CHANGE_ME@127.0.0.1:5432/portfoliohub_dev

# Separate test database + migration URL, used by the RLS isolation test suite.
DATABASE_TEST_MIGRATION_URL=postgres://portfoliohub_migrator:CHANGE_ME@127.0.0.1:5432/portfoliohub_test
DATABASE_TEST_URL=postgres://portfoliohub_app:CHANGE_ME@127.0.0.1:5432/portfoliohub_test

# Connection pool tuning
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# Restricted runtime role bootstrap (run `pnpm db:bootstrap-roles` once per
# fresh database, before running migrations). DB_APP_ROLE_PASSWORD is only
# needed for the bootstrap step, not at application runtime (it's already
# embedded in DATABASE_URL above).
DB_APP_ROLE=portfoliohub_app
DB_APP_ROLE_PASSWORD=CHANGE_ME

NODE_ENV=development

# JWT_SECRET signs short-lived access tokens (HS256). Must be at least 32
# characters; generate with e.g. `openssl rand -base64 32`.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Base URL the API uses to build OAuth callback URLs, and the frontend origin
# the OAuth callback redirects to after setting the refresh cookie.
OAUTH_REDIRECT_BASE_URL=http://localhost:3001
WEB_APP_URL=http://localhost:5173

# Register OAuth apps with Google/GitHub and set redirect URIs to
# <OAUTH_REDIRECT_BASE_URL>/auth/google/callback and
# <OAUTH_REDIRECT_BASE_URL>/auth/github/callback. Optional for automated
# tests (which mock provider HTTP calls), required for a live OAuth round trip.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

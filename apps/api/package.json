{
  "name": "@blueflutes/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:bootstrap-roles": "tsx src/scripts/bootstrap-roles.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:create-tenant": "tsx src/scripts/create-tenant.ts",
    "db:add-domain": "tsx src/scripts/add-domain.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@blueflutes/shared": "workspace:*",
    "arctic": "^3.7.0",
    "bullmq": "^6.4.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "drizzle-zod": "^0.5.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.3",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.30.1",
    "nock": "^14.0.15",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "undici": "7.25.0",
    "vitest": "^2.1.8"
  }
}

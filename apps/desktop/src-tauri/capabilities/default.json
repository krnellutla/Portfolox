{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "keyring:default",
    "updater:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://localhost:3001/auth/google*" },
        { "url": "http://localhost:3001/auth/github*" },
        { "url": "https://api.portfoliohub.example.com/auth/google*" },
        { "url": "https://api.portfoliohub.example.com/auth/github*" }
      ]
    }
  ]
}

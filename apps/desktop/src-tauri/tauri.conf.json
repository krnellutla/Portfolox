{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortfolioHub",
  "version": "0.1.0",
  "identifier": "com.portfoliohub.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PortfolioHub",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "schemes": ["portfoliohub"]
    },
    "updater": {
      "endpoints": ["https://updates.portfoliohub.example.com/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "REPLACE_WITH_GENERATED_UPDATER_PUBLIC_KEY"
    }
  }
}

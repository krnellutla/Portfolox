{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortfolioHub",
  "version": "0.1.0",
  "identifier": "com.portfoliohub.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PortfolioHub",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' https: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:3001 https://api.portfoliohub.example.com; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "schemes": ["portfoliohub"]
    },
    "updater": {
      "endpoints": ["https://updates.portfoliohub.example.com/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEREZDNzE1NDA1RDBDOTIKUldTU0RGMUFGY2ZmWFd2cHFtNTlDaFZLT1JXQVJwU2FUbXgxd21JRUp6ZEJKQ0xuYjN2RE5WbUEK"
    }
  }
}

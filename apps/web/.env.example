# Copy to .env for local development.
#
# Base URL of the API. The Vite dev server proxies /auth and /nodes to this
# target with changeOrigin: false, so the browser's original Host header
# (e.g. localhost:5173, or a tenant's custom host via /etc/hosts) reaches the
# API unchanged for host-based tenant resolution.
VITE_API_BASE_URL=http://localhost:3001

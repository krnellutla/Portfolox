# Copy to .env for local development.
#
# Base URL the browser uses for API requests. Leave empty (the default) for
# local dev: requests stay same-origin (localhost:5173) and are proxied to
# the API by the Vite dev server (see VITE_DEV_API_PROXY_TARGET below and
# vite.config.ts). Set to an absolute URL only if the API is served from a
# different origin with CORS configured for it.
#
# For the desktop (Tauri) production build, the bundled frontend is served
# from the tauri:// origin with no dev proxy, so this MUST be an absolute API
# URL — see .env.desktop.example.
VITE_API_BASE_URL=

# Where the Vite dev server proxies /auth and /nodes to. The proxy uses
# changeOrigin: false, so the browser's original Host header (e.g.
# localhost:5173, or a tenant's custom host via /etc/hosts) reaches the API
# unchanged for host-based tenant resolution.
VITE_DEV_API_PROXY_TARGET=http://localhost:3001

# Copy to .env.desktop.local (gitignored) before running
# `pnpm --filter @portfoliohub/desktop build:desktop`.
#
# Vite's "desktop" mode (`vite build --mode desktop`, used by the
# @portfoliohub/web `build:desktop` script) loads .env.desktop and
# .env.desktop.local in addition to .env. The desktop production build is
# served from the tauri:// origin with no dev proxy, so VITE_API_BASE_URL
# must be an absolute URL pointing at the deployed API, and that origin must
# be included in the API's CORS_ALLOWED_ORIGINS (and tenant_domains, for
# host-based tenant resolution).
VITE_API_BASE_URL=https://api.portfoliohub.example.com

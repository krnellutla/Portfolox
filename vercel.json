{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @blueflutes/shared build && pnpm --filter @blueflutes/web build",
  "outputDirectory": "apps/web/dist",
  "sourceFilesOutsideRootDirectory": true,
  "functions": {
    "api/[...path].ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "node_modules/@img/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://pxvyvkmjpomwpwcpgjwu.supabase.co; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://pxvyvkmjpomwpwcpgjwu.supabase.co tauri://localhost http://tauri.localhost https://tauri.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

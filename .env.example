# Root .env for docker-compose.
# Copy to .env and fill in real values before running `docker compose up`.
# Never commit the real .env file.

# ── Postgres ──────────────────────────────────────────────────────────────────
# Superuser password for the postgres container (used by DATABASE_MIGRATION_URL)
POSTGRES_PASSWORD=CHANGE_ME

# ── API runtime role ──────────────────────────────────────────────────────────
# Non-superuser, NOBYPASSRLS role used by the app connection pool.
# Run `pnpm db:bootstrap-roles` once after the first migration to provision it.
DB_APP_ROLE=portfoliohub_app
DB_APP_ROLE_PASSWORD=CHANGE_ME

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_at_least_32_characters_long
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── OAuth ─────────────────────────────────────────────────────────────────────
OAUTH_REDIRECT_BASE_URL=http://localhost:3001
WEB_APP_URL=http://localhost:8080

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated extra origins allowed credentialed cross-origin requests.
# Add tauri://localhost for the desktop shell.
CORS_ALLOWED_ORIGINS=

# ── Desktop OAuth deep-link ───────────────────────────────────────────────────
DESKTOP_AUTH_REDIRECT_URL=portfoliohub://auth/callback
